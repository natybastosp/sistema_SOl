// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo do Usuário
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  
  recommendationHistory   RecommendationHistory[]

  //Spotify
  spotifyAccessToken   String?   @db.Text
  spotifyRefreshToken  String?   @db.Text
  spotifyTokenExpiry   DateTime?
  spotifyUserId        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Preferências musicais do usuário
  musicPreferences String[] // Array de gêneros preferidos
  
  // Relacionamentos
  emotionalStates EmotionalState[]
  playlists       Playlist[]
  feedbacks       Feedback[]
  spotifyAuth     SpotifyAuth?
  
  @@map("users")
}

// Modelo do Estado Emocional
model EmotionalState {
  id        String   @id @default(cuid())
  userId    String
  
  // Emoções em escala 0-10
  sadness   Float
  joy       Float
  anger     Float
  fear      Float
  surprise  Float
  
  createdAt DateTime @default(now())
  
  // Relacionamentos
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlists Playlist[]
  
  @@map("emotional_states")
}

// Modelo da Música
model Music {
  id           String @id @default(cuid())
  spotifyId    String? @unique
  name         String
  artist       String
  album        String?
  duration     Int? // em milissegundos
  genre        String
  
  // Características emocionais da música (análise prévia)
  sadnessScore   Float
  joyScore       Float
  angerScore     Float
  fearScore      Float
  surpriseScore  Float
  
  // Características de áudio do Spotify
  danceability   Float?
  energy         Float?
  valence        Float?
  acousticness   Float?
  instrumentalness Float?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relacionamentos
  playlistMusics PlaylistMusic[]
  historyMusics    HistoryMusic[]
  
  @@map("musics")
}

// Modelo da Playlist
model Playlist {
  id                String   @id @default(cuid())
  userId            String
  emotionalStateId  String
  name              String
  description       String?
  
  createdAt         DateTime @default(now())
  
  // Relacionamentos
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotionalState    EmotionalState @relation(fields: [emotionalStateId], references: [id], onDelete: Cascade)
  playlistMusics    PlaylistMusic[]
  feedbacks         Feedback[]
  
  @@map("playlists")
}

// Tabela de relacionamento Playlist-Music
model PlaylistMusic {
  id         String @id @default(cuid())
  playlistId String
  musicId    String
  position   Int // posição da música na playlist
  
  // Relacionamentos
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  music      Music    @relation(fields: [musicId], references: [id], onDelete: Cascade)
  
  @@unique([playlistId, musicId])
  @@map("playlist_musics")
}

// Modelo de Feedback
model Feedback {
  id         String @id @default(cuid())
  userId     String
  playlistId String
  
  // Avaliação da playlist (1-5 estrelas)
  rating     Int
  
  // Estado emocional após ouvir a playlist
  postSadness   Float?
  postJoy       Float?
  postAnger     Float?
  postFear      Float?
  postSurprise  Float?
  
  // Comentário opcional
  comment    String?
  
  createdAt  DateTime @default(now())
  
  // Relacionamentos
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  
  @@map("feedbacks")
}

model RecommendationHistory {
  id                  String   @id @default(uuid())
  userId              String
  
  // Input do usuário
  estadoEmocional     Int
  generoPreferido     String?
  
  // Análise Fuzzy - Resultados principais
  intencaoPlaylist    String
  grauConfianca       Float
  valorIntencao       Float
  descricao           String?
  
  // Graus de pertinência (estados emocionais fuzzy)
  grauTriste          Float    @default(0)
  grauAnsioso         Float    @default(0)
  grauNeutro          Float    @default(0)
  grauAlegre          Float    @default(0)
  
  // Critérios aplicados (armazenado como JSON para flexibilidade)
  criteriosJson       Json
  
  // Informações da playlist gerada
  totalMusicas        Int
  duracaoMinutos      Int
  
  // Estatísticas da playlist
  valenciaMedia       Float
  energiaMedia        Float
  tristezaMedia       Float
  alegriaMedia        Float
  
  // Relacionamentos
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  musicas             HistoryMusic[]
  
  // Timestamps
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Índices para performance
  @@index([userId])
  @@index([createdAt])
  @@index([estadoEmocional])
  @@index([intencaoPlaylist])
  @@index([userId, createdAt])
  
  @@map("recommendation_history")
}

// Tabela intermediária: Músicas no histórico
model HistoryMusic {
  id          String                @id @default(uuid())
  historyId   String
  musicId     String
  position    Int                   // Posição na playlist (1, 2, 3...)
  
  // Relacionamentos
  history     RecommendationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  music       Music                 @relation(fields: [musicId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime              @default(now())
  
  // Garantir que a mesma música não apareça duas vezes no mesmo histórico
  @@unique([historyId, musicId])
  @@index([historyId])
  @@index([musicId])
  
  @@map("history_musics")
}

// Modelo para OAuth State (segurança CSRF)
model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("oauth_states")
}

// Modelo para armazenar tokens Spotify
model SpotifyAuth {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("spotify_auth")
}

