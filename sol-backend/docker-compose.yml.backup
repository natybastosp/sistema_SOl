version: "3.8"

services:
  # Banco de dados PostgreSQL para o sistema SOL
  postgres:
    image: postgres:15
    container_name: sol-postgres
    restart: always
    environment:
      POSTGRES_DB: sol_db
      POSTGRES_USER: sol_user
      POSTGRES_PASSWORD: sol_password
      POSTGRES_HOST_AUTH_METHOD: md5
    ports:
      - "5432:5432"
    volumes:
      # Persistir dados do banco mesmo quando container for recriado
      - postgres_data:/var/lib/postgresql/data
      # Scripts de inicialização (se necessário no futuro)
      - ./database/init:/docker-entrypoint-initdb.d
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sol_user -d sol_db"]
      interval: 30s
      timeout: 10s
      retries: 5

  # Adminer - Interface web para gerenciar o banco (opcional, mas útil)
  adminer:
    image: adminer
    container_name: sol-adminer
    restart: always
    ports:
      - "8080:8080"
    depends_on:
      - postgres

# Volumes para persistência de dados
volumes:
  postgres_data:
