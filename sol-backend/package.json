{
  "name": "sol-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:ts": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:check": "node scripts/check-database.js",
    "db:genres": "node scripts/list-genres.js",
    "db:genres:quick": "node scripts/quick-genres.js",
    "db:missing-spotify": "node scripts/check-missing-spotify.js",
    "spotify:example": "node scripts/spotify-search-example.js",
    "test:auth": "node scripts/test-auth-apis.js",
    "test:simple": "node scripts/simple-test.js",
    "data:analyze": "node scripts/analyze-data.js",
    "data:analyze:ts": "tsx scripts/analyze-data.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down --remove-orphans",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down --remove-orphans && docker container prune -f && docker volume prune -f",
    "docker:simple": "docker-compose -f docker-compose-simple.yml up -d",
    "setup": "npm run docker:up && npm run db:generate && npm run db:push && npm run db:seed",
    "dev:full": "npm run docker:up && npm run db:generate && npm run db:push && npm run dev"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.1",
    "fs-extra": "^11.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.548.0",
    "next": "15.3.5",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spotify-web-api-node": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
