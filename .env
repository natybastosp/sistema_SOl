# Criar .env com configurações básicas
cat > .env << 'EOF'
# === CONFIGURAÇÕES BÁSICAS ===
DATABASE_URL="postgresql://sol_user:sol_password_123@localhost:5432/sol_db"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="sol_super_secret_key_2024_change_in_production"

# === DATASETS ===
MAIN_DATASET_PATH="data/emotion_music_data.csv"
SPOTIFY_DATASET_PATH="data/musicas_perifericas.csv"
ORIGINAL_DATASET_PATH="data/emotion_music_data_original.csv"

# === IA ===
FUZZY_SYSTEM_ENABLED=true
MIN_RECOMMENDATION_SCORE=0.5
DEFAULT_PLAYLIST_SIZE=10

# === API ===
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
PORT=8000
HOST="127.0.0.1"
EOF
